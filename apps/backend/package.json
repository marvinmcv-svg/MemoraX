{
  "name": "@memorax/backend",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "worker": "tsx --env-file=.env src/workers/scheduler.ts"
  },
  "dependencies": {
    "@clerk/clerk-sdk-node": "^5.0.0",
    "@google/generative-ai": "^0.21.0",
    "@memorax/ai": "workspace:*",
    "@memorax/db": "workspace:*",
    "@memorax/shared": "workspace:*",
    "@neondatabase/serverless": "^0.9.0",
    "@upstash/redis": "^1.28.0",
    "bullmq": "^5.4.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "express": "^4.19.0",
    "ioredis": "^5.3.0",
    "node-cron": "^3.0.3",
    "openai": "^4.47.0",
    "rrule": "^2.8.0",
    "stripe": "^15.5.0",
    "uuid": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.0.0",
    "tsx": "^4.10.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
