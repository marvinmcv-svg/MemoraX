FROM node:20-alpine AS builder
WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-workspace.yaml tsconfig.json ./
COPY apps/backend/package.json apps/backend/
COPY packages/ai/package.json packages/ai/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/

RUN pnpm install

COPY apps/backend /app/apps/backend
COPY packages/ai /app/packages/ai
COPY packages/db /app/packages/db
COPY packages/shared /app/packages/shared
COPY tsconfig.json /app/tsconfig.json

WORKDIR /app/packages/db
RUN pnpm exec tsc --skipLibCheck --module commonjs --moduleResolution node --esModuleInterop

WORKDIR /app/packages/ai
RUN pnpm exec tsc --skipLibCheck --module commonjs --moduleResolution node --esModuleInterop

WORKDIR /app/apps/backend
RUN pnpm build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/apps/backend/dist /app/apps/backend/dist
COPY --from=builder /app/apps/backend/node_modules /app/apps/backend/node_modules
COPY --from=builder /app/packages/db/dist /app/packages/db/dist
COPY --from=builder /app/packages/db/node_modules /app/packages/db/node_modules
COPY --from=builder /app/packages/db/package.json /app/packages/db/package.json
COPY --from=builder /app/packages/ai/dist /app/packages/ai/dist
COPY --from=builder /app/packages/ai/node_modules /app/packages/ai/node_modules
COPY --from=builder /app/packages/ai/package.json /app/packages/ai/package.json
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/apps/backend/package.json /app/apps/backend/package.json

WORKDIR /app/apps/backend

EXPOSE 3001

# Run migration on startup if DATABASE_URL is set
CMD ["sh", "-c", "node dist/apps/backend/src/scripts/run-migration.js && node dist/apps/backend/src/index.js"]