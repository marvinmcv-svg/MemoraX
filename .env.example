# MemoraX Environment Variables Template
# Copy this file to .env and fill in the values

# ==========================================
# AI Services (required for AI pipeline)
# ==========================================
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
OPENAI_API_KEY=sk-your_openai_key
DEEPGRAM_API_KEY=your_deepgram_key

# ==========================================
# Database (PostgreSQL via Neon recommended)
# ==========================================
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ==========================================
# Redis (Upstash for API Gateway)
# ==========================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ==========================================
# Auth (Clerk)
# ==========================================
CLERK_SECRET_KEY=sk_test_your_clerk_secret
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable

# ==========================================
# API URLs
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001

# ==========================================
# Stripe (for billing)
# ==========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# ==========================================
# WhatsApp Integration
# ==========================================
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_id
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ==========================================
# Telegram Integration
# ==========================================
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2vI1234ER

# ==========================================
# SMS (Twilio)
# ==========================================
TWILIO_ACCOUNT_SID=ACyour_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890

# ==========================================
# Slack Integration
# ==========================================
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_TOKEN=xoxb-your-slack-token

# ==========================================
# Ports
# ==========================================
PORT=3001

# ==========================================
# Email (Resend - for email capture)
# ==========================================
RESEND_API_KEY=re_your_resend_key

# ==========================================
# Optional: Neo4j (Knowledge Graph)
# ==========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password